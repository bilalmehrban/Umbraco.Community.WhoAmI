<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.WhoAmI</Product>
    <PackageId>Umbraco.Community.WhoAmI</PackageId>
    <Title>Who Am I</Title>
    <Description>Shows the current backoffice user's assigned user groups in the current-user panel, using the Umbraco UI Library.</Description>
    <PackageTags>umbraco;umbraco-marketplace;backoffice;user-groups</PackageTags>
    <Authors>Bilal Mehrban</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Bilal Mehrban</Copyright>
    <PackageProjectUrl>https://github.com/bilalmehrban/Umbraco.Community.WhoAmI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bilalmehrban/Umbraco.Community.WhoAmI</RepositoryUrl>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dont include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\README_nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\docs\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
